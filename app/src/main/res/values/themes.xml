<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (Light) -->
    <style name="Theme.SnapTask" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#F7F4EC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F7F4EC</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F7F4EC</item>
    </style>

    <!-- Android 12+ SplashScreen Starting Theme -->
    <style name="Theme.SnapTask.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#17140A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_snaptask_splash</item>
        <item name="windowSplashScreenAnimationDuration">650</item>
        <item name="postSplashScreenTheme">@style/Theme.SnapTask</item>
    </style>
</resources>
