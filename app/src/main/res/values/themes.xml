<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SnapTask" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#F3F2EC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F3F2EC</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F3F2EC</item>
    </style>

    <style name="Theme.SnapTask.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F0F0E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_snaptask_splash</item>
        <item name="windowSplashScreenAnimationDuration">650</item>
        <item name="postSplashScreenTheme">@style/Theme.SnapTask</item>
    </style>
</resources>
