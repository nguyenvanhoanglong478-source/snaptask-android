<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <!-- 1. Outer Ring Group -->
            <group
                android:name="ring_group"
                android:pivotX="54"
                android:pivotY="54">
                <path
                    android:name="outer_ring"
                    android:strokeColor="#FFD23F"
                    android:strokeWidth="7"
                    android:strokeLineCap="round"
                    android:fillColor="#00000000"
                    android:pathData="M54,24.5 A29.5,29.5 0 1,1 53.99,24.5"
                    android:trimPathEnd="0" />
            </group>

            <!-- 2. Inner Disk & Tick Mark Group -->
            <group
                android:name="disk_group"
                android:pivotX="54"
                android:pivotY="54">
                <path
                    android:name="inner_disk"
                    android:fillColor="#FFD23F"
                    android:pathData="M54,35 A19,19 0 1,1 53.99,35 Z" />

                <path
                    android:name="tick_mark"
                    android:strokeColor="#17140A"
                    android:strokeWidth="6.5"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:pathData="M45,55 L51.5,61.5 L63.5,47"
                    android:trimPathEnd="0" />
            </group>
        </vector>
    </aapt:attr>

    <!-- Animation Target: Outer Ring (trimPathEnd 0 -> 1) -->
    <target android:name="outer_ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="450"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <!-- Animation Target: Inner Disk Group (Scale 0 -> 1 with Overshoot) -->
    <target android:name="disk_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="80"
                    android:duration="380"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="80"
                    android:duration="380"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- Animation Target: Tick Mark (trimPathEnd 0 -> 1) -->
    <target android:name="tick_mark">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:startOffset="320"
                android:duration="280"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

</animated-vector>
