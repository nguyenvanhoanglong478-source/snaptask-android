<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <group
                android:name="ring_group"
                android:pivotX="54"
                android:pivotY="54">
                <path
                    android:name="outer_ring"
                    android:strokeColor="#D4FF3A"
                    android:strokeWidth="4.7"
                    android:strokeLineCap="round"
                    android:fillColor="#00000000"
                    android:pathData="M54,34.3 A19.7,19.7 0 1,1 53.99,34.3"
                    android:trimPathEnd="0" />
            </group>

            <group
                android:name="disk_group"
                android:pivotX="54"
                android:pivotY="54">
                <path
                    android:name="inner_disk"
                    android:fillColor="#D4FF3A"
                    android:pathData="M54,41.3 A12.7,12.7 0 1,1 53.99,41.3 Z" />

                <path
                    android:name="tick_mark"
                    android:strokeColor="#10120A"
                    android:strokeWidth="4.3"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:pathData="M48,54.7 L52.3,59 L60.3,49.3"
                    android:trimPathEnd="0" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="outer_ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="450"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="disk_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="80"
                    android:duration="380"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="80"
                    android:duration="380"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="tick_mark">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:startOffset="320"
                android:duration="280"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

</animated-vector>
